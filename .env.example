# Forge configuration contract.
#
# This file lists EVERY environment variable the app reads at runtime. It holds no
# secrets and ships with the repo and the published container image, so an operator
# deploying `ghcr.io/zhixuan312/forge:<version>` can configure an instance without
# reading the source.
#
# Only DATABASE_URL and FORGE_SECRET_KEY are hard-required to boot. Everything else
# has a working default.

# ── Required ────────────────────────────────────────────────────────────────────

# Postgres connection (Forge's own DB). Bring your own managed Postgres, or use the
# optional `postgres` profile in docker-compose.yml for a local one.
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# 32-byte base64 master key for app_secrets (libsodium secretbox).
# Generate with: openssl rand -base64 32
FORGE_SECRET_KEY=

# The first admin is created on first run via the /setup registration page
# (no env-var bootstrap). Visit the app with an empty DB and you'll be sent there.

# ── MMA engine integration ──────────────────────────────────────────────────────

# Base URL of the MMA engine. Precedence: persisted Connections row > this env var >
# http://127.0.0.1:7337. Inside Docker Compose set this to the service name —
# e.g. http://mma:7337 — because loopback there resolves to the Forge container itself.
MMA_BASE_URL=

# MMA bearer token. Forge does not own this token: it reads MMA_AUTH_TOKEN, else the
# co-located <MMA_HOME|$HOME>/.mma/auth-token file that mma writes.
MMA_AUTH_TOKEN=

# Which provider the container generates an MMA config for when no config.json is
# mounted: `anthropic` (claude tiers, reads ANTHROPIC_API_KEY) or `openai`
# (codex tiers, reads OPENAI_API_KEY). Mount your own ~/.mma/config.json to run a
# mixed or self-hosted tier layout instead — a mounted config always wins.
PROVIDER=anthropic

# API keys for the generated config. Supply the one matching PROVIDER. Leave both
# blank to run in OAuth mode, which requires mounting ~/.claude and/or ~/.codex.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Path the config-supervisor WRITES the rendered MMA config.json to. Defaults to
# <MMA_HOME|$HOME>/.mma/config.json. Set this to a throwaway path in dev so applying
# config never mutates your real config.
MMA_CONFIG_PATH=

# Co-located MMA install root, used to locate the bundled model-profiles catalog and
# to resolve the config/token dir. Leave blank to use the install path + $HOME.
MMA_HOME=

# X-MMA-Client value sent to mma. The server rejects unknown clients on TOOL routes
# with `400 client_required` (allowlist: claude-code|cursor|codex-cli|gemini-cli).
MMA_CLIENT=

# Per-request timeout (ms) for calls to the MMA engine.
MMA_FETCH_TIMEOUT=

# ── Workspace / storage ─────────────────────────────────────────────────────────

# Where Forge clones team repos. Defaults to <cwd>/.forge-workspace.
# In a container this MUST be a persistent volume — project artifacts, the journal,
# and git worktrees all live on disk under here.
FORGE_WORKSPACE_ROOT=

# Parent directory that each team's workspace root must be a direct child of.
FORGE_WORKSPACE_BASE=

# ── HTTP / session security ─────────────────────────────────────────────────────

# Client-IP resolution for rate-limiting: 1 = behind a trusted reverse proxy
# (use the left-most X-Forwarded-For hop), 0 = use the socket address.
FORGE_TRUST_PROXY=0

# Set to true when serving over HTTPS so session cookies carry the Secure flag.
FORGE_COOKIE_SECURE=

# Session lifetimes (ms).
SESSION_ABSOLUTE_TTL=
SESSION_IDLE_TTL=

# Login throttling.
LOGIN_RATELIMIT_MAX=
LOGIN_RATELIMIT_WINDOW=

# Minimum password length enforced at registration.
PASSWORD_MIN_LENGTH=

# Argon2id password-hashing parameters. Raise on bigger hosts; lower only if boot
# is memory-constrained.
ARGON2_MEMORY_KIB=
ARGON2_ITERATIONS=
ARGON2_PARALLELISM=

# ── Database tuning ─────────────────────────────────────────────────────────────

# Max Postgres pool connections.
FORGE_DB_POOL_MAX=

# ── Runtime ─────────────────────────────────────────────────────────────────────

# `production` in the published image; `development` for local dev.
NODE_ENV=
