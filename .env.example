# Forge configuration contract.
#
# This file lists EVERY environment variable the app reads at runtime. It holds no
# secrets and ships with the repo and the published container image, so an operator
# deploying `ghcr.io/zhixuan312/forge:<version>` can configure an instance without
# reading the source.
#
# Only DATABASE_URL and FORGE_SECRET_KEY are hard-required to boot. Everything else
# has a working default.

# ── Required ────────────────────────────────────────────────────────────────────

# Postgres connection (Forge's own DB). Bring your own managed Postgres, or use the
# optional `postgres` profile in docker-compose.yml for a local one.
DATABASE_URL=postgres://forge:forge@localhost:5432/forge

# 32-byte base64 master key for app_secrets (libsodium secretbox).
# Generate with: openssl rand -base64 32
FORGE_SECRET_KEY=

# The first admin is created on first run via the /setup registration page
# (no env-var bootstrap). Visit the app with an empty DB and you'll be sent there.

# ── MMA engine integration ──────────────────────────────────────────────────────

# Base URL of the MMA engine. Precedence: persisted Connections row > this env var >
# http://127.0.0.1:7337. Inside Docker Compose set this to the service name —
# e.g. http://mma:7337 — because loopback there resolves to the Forge container itself.
MMA_BASE_URL=

# MMA bearer token. Forge does not own this token: it reads MMA_AUTH_TOKEN, else the
# co-located <MMA_HOME|$HOME>/.mma/auth-token file that mma writes.
MMA_AUTH_TOKEN=

# ── Generated MMA config (skipped entirely if you mount ~/.mma/config.json) ─────
#
# The engine has three tiers — standard, complex, main — and each is configured
# independently by three knobs:
#
#   PROVIDER_<TIER>     wire protocol: `claude` (Anthropic-compatible API) or
#                       `codex` (OpenAI-compatible API). `anthropic` and `openai`
#                       are accepted aliases. PROVIDER sets the default for all tiers.
#   BASE_URL_<TIER>     the vendor endpoint. Blank = that protocol's own API.
#   API_KEY_ENV_<TIER>  the NAME of the env var holding that tier's key.
#                       Blank = ANTHROPIC_API_KEY (claude) / OPENAI_API_KEY (codex).
#
# The protocol is NOT the vendor. Many providers speak a standard protocol behind
# their own base URL — DeepSeek, Z.ai/GLM, Kimi and MiniMax all expose
# Anthropic-compatible endpoints, so they are `claude` tiers with their own URL+key.
#
# Example — a mixed, multi-vendor layout:
#
#   PROVIDER=claude
#   MODEL_STANDARD=MiniMax-M3
#   BASE_URL_STANDARD=https://api.minimax.io/anthropic
#   API_KEY_ENV_STANDARD=MINIMAX_API_KEY
#   MINIMAX_API_KEY=<your minimax key>
#   PROVIDER_COMPLEX=codex
#   MODEL_COMPLEX=gpt-5.4
#   MODEL_MAIN=claude-opus-4-8
#
PROVIDER=claude
PROVIDER_STANDARD=
PROVIDER_COMPLEX=
PROVIDER_MAIN=

# Optional per-tier model override. Blank uses that protocol's default for the tier.
MODEL_STANDARD=
MODEL_COMPLEX=
MODEL_MAIN=

# Optional per-tier vendor endpoint.
BASE_URL_STANDARD=
BASE_URL_COMPLEX=
BASE_URL_MAIN=

# Optional per-tier key env-var NAME (not the key itself).
API_KEY_ENV_STANDARD=
API_KEY_ENV_COMPLEX=
API_KEY_ENV_MAIN=

# Default keys for tiers that do not name their own env var. A tier whose key env
# var is unset stays keyless and falls back to that protocol's native OAuth, which
# requires mounting ~/.claude (claude) and/or ~/.codex (codex). A tier never borrows
# another tier's key.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Path the config-supervisor WRITES the rendered MMA config.json to. Defaults to
# <MMA_HOME|$HOME>/.mma/config.json. Set this to a throwaway path in dev so applying
# config never mutates your real config.
MMA_CONFIG_PATH=

# Co-located MMA install root, used to locate the bundled model-profiles catalog and
# to resolve the config/token dir. Leave blank to use the install path + $HOME.
MMA_HOME=

# X-MMA-Client value sent to mma. The server rejects unknown clients on TOOL routes
# with `400 client_required` (allowlist: claude-code|cursor|codex-cli|gemini-cli).
MMA_CLIENT=

# Per-request timeout (ms) for calls to the MMA engine.
MMA_FETCH_TIMEOUT=

# ── Workspace / storage ─────────────────────────────────────────────────────────

# Where Forge clones team repos. Defaults to <cwd>/.forge-workspace.
# In a container this MUST be a persistent volume — project artifacts, the journal,
# and git worktrees all live on disk under here.
FORGE_WORKSPACE_ROOT=

# Parent directory that each team's workspace root must be a direct child of.
FORGE_WORKSPACE_BASE=

# ── PDF export (puppeteer / headless Chrome) ────────────────────────────────────
#
# Read through src/export/config.ts rather than process.env directly. The published
# image ships Chromium; if it is missing, export fails with `pdf_engine_unavailable`.

# Where rendered exports are written. Needs a persistent volume in a container.
FORGE_EXPORT_ROOT=

# Per-render timeout (ms).
FORGE_PDF_TIMEOUT_MS=

# Reject source documents larger than this many bytes.
FORGE_PDF_MAX_SOURCE_BYTES=

# Max queued render jobs before new requests are rejected.
FORGE_PDF_MAX_QUEUE=

# Pass --no-sandbox to Chrome. Required when the container runs as root.
FORGE_PDF_NO_SANDBOX=

# Override the render worker entrypoint. Blank uses the bundled worker.
FORGE_PDF_WORKER_PATH=

# Explicit Chrome/Chromium binary path. Blank uses the image's bundled browser.
PUPPETEER_EXECUTABLE_PATH=

# ── HTTP / session security ─────────────────────────────────────────────────────

# Client-IP resolution for rate-limiting: 1 = behind a trusted reverse proxy
# (use the left-most X-Forwarded-For hop), 0 = use the socket address.
FORGE_TRUST_PROXY=0

# Set to true when serving over HTTPS so session cookies carry the Secure flag.
FORGE_COOKIE_SECURE=

# Session lifetimes (ms).
SESSION_ABSOLUTE_TTL=
SESSION_IDLE_TTL=

# Login throttling.
LOGIN_RATELIMIT_MAX=
LOGIN_RATELIMIT_WINDOW=

# Minimum password length enforced at registration.
PASSWORD_MIN_LENGTH=

# Argon2id password-hashing parameters. Raise on bigger hosts; lower only if boot
# is memory-constrained.
ARGON2_MEMORY_KIB=
ARGON2_ITERATIONS=
ARGON2_PARALLELISM=

# ── Database tuning ─────────────────────────────────────────────────────────────

# Max Postgres pool connections.
FORGE_DB_POOL_MAX=

# ── Runtime ─────────────────────────────────────────────────────────────────────

# `production` in the published image; `development` for local dev.
NODE_ENV=

# ── Build-time provenance (set by `docker build --build-arg`, not at runtime) ────
#
# These are baked into the image at build time and reported by GET /api/version, so
# a running instance can state exactly which build it is. The release runbook sets
# them from `git rev-parse --short HEAD` and `date -u +"%Y-%m-%dT%H:%M:%SZ"`.
# Leave blank for local dev; /api/version then reports the fallback.
FORGE_BUILD_GIT_SHA=
FORGE_BUILD_BUILT_AT=
